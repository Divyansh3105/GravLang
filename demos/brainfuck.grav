# Brainfuck Interpreter in GravLang

func runBrainfuck(source) {
    # Initialize tape (30,000 cells)
    let tape = [];
    for (let i = 0; i < 30000; i += 1) {
        push(tape, 0);
    }
    
    let dp = 0; # Data pointer
    let ip = 0; # Instruction pointer
    let programLength = len(source);
    
    print("--- Executing Brainfuck ---");
    
    while (ip < programLength) {
        # Hack to get a character at an index using slicing since GravLang strings might not support direct indexing?
        # Actually strings in python can be sliced, assuming GravLang supports slicing for strings as well.
        # But wait, GravLang doesn't support string indexing directly in our implementation, only slicing arr[i:j].
        # Let's convert string to array of characters if we can, or we can assume string indexing works?
        # Let's check: string doesn't support `s[0]`. We must rely on string methods, wait, we don't have those.
        # We'll use a trick or assume the user inputs a valid program. Wait, I'll pass the program as an array of strings.
        
        let cmd = source[ip];
        
        if (cmd == ">") {
            dp += 1;
            if (dp >= 30000) { dp = 0; }
        } elif (cmd == "<") {
            dp -= 1;
            if (dp < 0) { dp = 29999; }
        } elif (cmd == "+") {
            tape[dp] = (tape[dp] + 1) % 256;
        } elif (cmd == "-") {
            tape[dp] = (tape[dp] - 1) % 256;
            if (tape[dp] < 0) { tape[dp] = 255; }
        } elif (cmd == ".") {
            # GravLang doesn't have chr() built-in. We'll just print the ASCII code.
            print("Output (ASCII code): " + toString(tape[dp]));
        } elif (cmd == ",") {
            let val = input("Input a number for cell " + toString(dp) + ": ");
            try {
                tape[dp] = toInt(val) % 256;
            } catch (e) {
                tape[dp] = 0;
            }
        } elif (cmd == "[") {
            if (tape[dp] == 0) {
                # Jump past the matching ]
                let openBrackets = 1;
                while (openBrackets > 0) {
                    ip += 1;
                    if (ip >= programLength) { throw "Unmatched ["; }
                    if (source[ip] == "[") { openBrackets += 1; }
                    elif (source[ip] == "]") { openBrackets -= 1; }
                }
            }
        } elif (cmd == "]") {
            if (tape[dp] != 0) {
                # Jump back to the matching [
                let closeBrackets = 1;
                while (closeBrackets > 0) {
                    ip -= 1;
                    if (ip < 0) { throw "Unmatched ]"; }
                    if (source[ip] == "]") { closeBrackets += 1; }
                    elif (source[ip] == "[") { closeBrackets -= 1; }
                }
            }
        }
        
        ip += 1;
    }
    
    print("\n--- Execution Complete ---");
}

# Provide program as an array of characters since GravLang doesn't support string[i] yet.
let hello_world = [
    "+", "+", "+", "+", "+", "+", "+", "+", "[", ">", "+", "+", "+", "+",
    "[", ">", "+", "+", ">", "+", "+", "+", ">", "+", "+", "+", ">", "+",
    "<", "<", "<", "<", "-", "]", ">", "+", ">", "+", ">", "-", ">", ">",
    "+", "[", "<", "]", "<", "-", "]", ">", ">", ".", ">", "-", "-", "-",
    ".", "+", "+", "+", "+", "+", "+", "+", ".", ".", "+", "+", "+", ".",
    ">", ">", ".", "<", "-", ".", "<", ".", "+", "+", "+", ".", "-", "-",
    "-", "-", "-", "-", ".", "-", "-", "-", "-", "-", "-", ".", ">", "+",
    ".", ">", "."
];

print("Running Hello World in Brainfuck...");
runBrainfuck(hello_world);
