# lib/math.grav — GravLang standard math library module

# ── Constants ────────────────────────────────────────────────────────
let PI  = 3.14159265358979;
let E   = 2.71828182845905;

# ── Basic math functions ─────────────────────────────────────────────
func abs(n) {
    if (n < 0) { return n * -1; }
    return n;
}

func min(a, b) {
    if (a < b) { return a; }
    return b;
}

func max(a, b) {
    if (a > b) { return a; }
    return b;
}

func clamp(val, lo, hi) {
    return max(lo, min(val, hi));
}

func sign(n) {
    if (n > 0) { return 1; }
    if (n < 0) { return -1; }
    return 0;
}

# ── Power / root ─────────────────────────────────────────────────────
func pow(base, exp) {
    return base ** exp;
}

func sqrt(n) {
    if (n < 0) { return null; }
    if (n == 0) { return 0; }
    return n ** 0.5;   # exact to float precision (fixed iteration counts were wrong for large n)
}

# ── Rounding ─────────────────────────────────────────────────────────
func floor(n) {
    let i = toInt(n);
    if (n < 0 and toFloat(i) != n) { return i - 1; }
    return i;
}

func ceil(n) {
    let i = toInt(n);
    if (n > 0 and toFloat(i) != n) { return i + 1; }
    return i;
}

func round(n) {
    return floor(n + 0.5);
}

# ── Factorial & Fibonacci ─────────────────────────────────────────────
# iterative: the call-depth limit (200) would reject recursive versions for larger n
func factorial(n) {
    let result = 1;
    let i = 2;
    while (i <= n) { result *= i; i += 1; }
    return result;
}

func fib(n) {
    if (n <= 1) { return n; }
    let a = 0;
    let b = 1;
    let i = 2;
    while (i <= n) {
        let next = a + b;
        a = b;
        b = next;
        i += 1;
    }
    return b;
}
